{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "3d-planet-detect",
  // Worker 只處理 /api/*（網頁版完整版序號），其他都是 dist/ 的靜態檔
  "main": "worker/index.js",
  "compatibility_date": "2026-10-19",
  // 部署前先建置：Cloudflare 只會 npm ci 再 wrangler deploy，沒有這步 dist/ 不存在
  "build": {
    "command": "npm run build"
  },
  // 品牌網域；加了 routes 後 workers.dev 預設會關閉，要明確保留舊網址
  "routes": [{ "pattern": "planet.emptyoffice.app", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Lemon Squeezy 商店 Empty Office 與「星球失物招領所 完整版」商品；商店正式收款後把 LS_LIVE 改成 "1"
  "vars": { "LS_STORE_ID": "507523", "LS_PRODUCT_ID": "1474126", "LS_LIVE": "0" }
}
